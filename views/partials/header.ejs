<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title><%= title %> | PantrySync</title>
    <link rel="stylesheet" href="/css/app.css">
    <style>
        *{margin:0;padding:0;box-sizing:border-box;}
        body{font-family:Arial,sans-serif;background:#f5f5f5;}
        nav{background:#333;color:white;padding:15px 20px;display:flex;justify-content:space-between;flex-wrap:wrap;}
        nav a{color:white;text-decoration:none;margin:0 10px;}
        nav button{background:none;border:none;color:white;cursor:pointer;}
        .nav-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
        .container{max-width:1200px;margin:0 auto;padding:20px;min-height:calc(100vh - 140px);}
        @media(max-width:768px){nav{flex-direction:column;gap:10px;}}
    </style>
</head>
<body>
    <nav>
        <div style="font-size:20px;">🍽️ PantrySync</div>
        <div class="nav-right">
            <a href="/">Home</a>
            <% if (user) { %>
                <a href="/dashboard">Dashboard</a>
                <a href="/recipes">Recipes</a>
                <a href="/shopping-list">Shopping</a>
                <% if (user.isAdmin) { %>
                    <a href="/admin">Admin</a>
                <% } %>
                <form action="/logout" method="POST" style="display:inline;"><button>Logout</button></form>
                <span>👤 <%= user.username %></span>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </div>
    </nav>
    <main class="container">