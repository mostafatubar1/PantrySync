<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shopping List - PantrySync</title>
  <link rel="stylesheet" href="/css/shopping.css" />
</head>
<body>

  <nav class="navbar">
    <a href="/" class="nav-brand">PantrySync</a>
    <div class="nav-links">
      <a href="/dashboard">My Pantry</a>
      <a href="/recipes">Recipes</a>
      <a href="/shopping-list" class="active">Shopping List</a>
      <% if (user && user.role === 'admin') { %>
        <a href="/admin">Admin</a>
      <% } %>
      <a href="/logout">Logout</a>
    </div>
  </nav>

  <div class="page-wrapper">

    <div class="page-header">
      <h1>My Shopping List</h1>
      <p class="page-subtitle">
        <%= pendingCount %> item(s) pending &nbsp;|&nbsp; Estimated total: <strong><%= estimatedTotal %> EGP</strong>
      </p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div class="card">
      <h2>Add Item</h2>
      <form action="/shopping-list/add" method="POST" class="add-form">
        <div class="form-row">
          <div class="form-group">
            <label for="name">Item Name</label>
            <input type="text" id="name" name="name" placeholder="e.g. Milk" required />
          </div>
          <div class="form-group">
            <label for="quantity">Quantity</label>
            <input type="number" id="quantity" name="quantity" placeholder="e.g. 2" min="0" step="0.1" required />
          </div>
          <div class="form-group">
            <label for="unit">Unit</label>
            <select id="unit" name="unit">
              <option value="pcs">pcs</option>
              <option value="kg">kg</option>
              <option value="g">g</option>
              <option value="L">L</option>
              <option value="ml">ml</option>
              <option value="pack">pack</option>
              <option value="bunch">bunch</option>
              <option value="can">can</option>
            </select>
          </div>
          <div class="form-group">
            <label for="estimatedCost">Est. Cost (EGP)</label>
            <input type="number" id="estimatedCost" name="estimatedCost" placeholder="0" min="0" step="0.01" />
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Add to List</button>
      </form>
    </div>

    <div class="section">
      <h2>Pending (<%= pendingCount %>)</h2>
      <% if (pendingItems.length === 0) { %>
        <p class="empty-message">No pending items. Add something above!</p>
      <% } else { %>
        <div class="items-list">
          <% pendingItems.forEach(function(item) { %>
            <div class="shopping-card" id="card-<%= item._id %>">
              <div class="item-info">
                <span class="item-name"><%= item.name %></span>
                <span class="item-details">
                  <%= item.quantity %> <%= item.unit %>
                  <% if (item.estimatedCost > 0) { %>
                    &nbsp;·&nbsp; <%= item.estimatedCost %> EGP
                  <% } %>
                </span>
              </div>
              <div class="item-actions">
                <button class="btn btn-small btn-success toggle-btn" data-id="<%= item._id %>" data-bought="false">
                  ✓ Mark Bought
                </button>
                <button class="btn btn-small btn-warning edit-btn" data-id="<%= item._id %>" data-name="<%= item.name %>" data-quantity="<%= item.quantity %>" data-unit="<%= item.unit %>" data-cost="<%= item.estimatedCost %>">
                  Edit
                </button>
                <button class="btn btn-small btn-danger delete-btn" data-id="<%= item._id %>">
                  Delete
                </button>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <div class="section">
      <h2>Bought (<%= boughtItems.length %>)</h2>
      <% if (boughtItems.length === 0) { %>
        <p class="empty-message">Nothing marked as bought yet.</p>
      <% } else { %>
        <div class="items-list">
          <% boughtItems.forEach(function(item) { %>
            <div class="shopping-card bought-card" id="card-<%= item._id %>">
              <div class="item-info">
                <span class="item-name bought-name"><%= item.name %></span>
                <span class="item-details"><%= item.quantity %> <%= item.unit %></span>
              </div>
              <div class="item-actions">
                <button class="btn btn-small btn-warning toggle-btn" data-id="<%= item._id %>" data-bought="true">
                  Undo
                </button>
                <button class="btn btn-small btn-danger delete-btn" data-id="<%= item._id %>">
                  Delete
                </button>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

  </div>

  <div id="edit-modal" class="modal hidden">
    <div class="modal-box">
      <h2>Edit Item</h2>
      <form id="edit-form" method="POST" action="">
        <div class="form-group">
          <label for="edit-name">Item Name</label>
          <input type="text" id="edit-name" name="name" required />
        </div>
        <div class="form-group">
          <label for="edit-quantity">Quantity</label>
          <input type="number" id="edit-quantity" name="quantity" min="0" step="0.1" required />
        </div>
        <div class="form-group">
          <label for="edit-unit">Unit</label>
          <select id="edit-unit" name="unit">
            <option value="pcs">pcs</option>
            <option value="kg">kg</option>
            <option value="g">g</option>
            <option value="L">L</option>
            <option value="ml">ml</option>
            <option value="pack">pack</option>
            <option value="bunch">bunch</option>
            <option value="can">can</option>
          </select>
        </div>
        <div class="form-group">
          <label for="edit-cost">Est. Cost (EGP)</label>
          <input type="number" id="edit-cost" name="estimatedCost" min="0" step="0.01" />
        </div>
        <div class="modal-buttons">
          <button type="submit" class="btn btn-primary">Save</button>
          <button type="button" id="close-modal" class="btn btn-secondary">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/shopping.js"></script>
</body>
</html>
